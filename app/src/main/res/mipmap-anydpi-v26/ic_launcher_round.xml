<?xml version="1.0" encoding="utf-8"?>
<!--
  The same layers. An adaptive icon is masked by the launcher showing it, so the
  round variant differs from the square one only in which mask is applied — a
  separate drawing would be a second thing to keep in step for no gain.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
