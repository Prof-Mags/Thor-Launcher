<?xml version="1.0" encoding="utf-8"?>
<!--
  The plate behind the mark.

  A gradient rather than a flat fill, angled the same way the device's own
  shells are, so the icon has one light source instead of two. Dark because the
  launcher is: a pale icon would be the only bright thing on a home screen
  otherwise made of box art.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF141A24" />
                <item android:offset="0.55" android:color="#FF0E1116" />
                <item android:offset="1" android:color="#FF080A0E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
