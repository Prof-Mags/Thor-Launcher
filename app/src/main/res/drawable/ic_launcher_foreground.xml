<?xml version="1.0" encoding="utf-8"?>
<!--
  Loki's mark: the device it runs on.

  A clamshell handheld seen face on, and almost nothing else. The first version
  of this drew a pad and four buttons as well, which at the 48dp a home screen
  actually shows an icon at is not detail — it is noise, four grey specks that
  make the shape harder to read rather than easier. What survives is the one
  thing that identifies the machine: two lit screens, one above the other, with
  a hinge between them.

  Contrast does the work. The screens are the brightest thing in the icon and
  they take most of its area; the body is a slate frame around them, light
  enough to separate from the plate behind. Dark chrome with small screens
  inside it — which is what this was — reads as a dark blob at any size below a
  settings row.

  Everything sits inside a 44 x 56 box centred on the 108 grid. With a 7-unit
  corner the furthest painted point is about 33 from the centre, which is the
  radius of the circle an adaptive icon is guaranteed to keep.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The body: one piece, so the hinge is a detail on it rather than a seam. -->
    <path
        android:pathData="M39,26 L69,26 A7,7 0 0 1 76,33 L76,75 A7,7 0 0 1 69,82 L39,82 A7,7 0 0 1 32,75 L32,33 A7,7 0 0 1 39,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="82"
                android:type="linear">
                <item android:offset="0" android:color="#FF2E394A" />
                <item android:offset="1" android:color="#FF171D26" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top screen: the wide one, and the brightest thing here. -->
    <path
        android:pathData="M37.5,29.5 L70.5,29.5 A2,2 0 0 1 72.5,31.5 L72.5,49 A2,2 0 0 1 70.5,51 L37.5,51 A2,2 0 0 1 35.5,49 L35.5,31.5 A2,2 0 0 1 37.5,29.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35.5"
                android:startY="29.5"
                android:endX="72.5"
                android:endY="51"
                android:type="linear">
                <item android:offset="0" android:color="#FF6FB0FF" />
                <item android:offset="1" android:color="#FF6F6BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- A sliver of glass across it, so it reads as a screen and not a swatch. -->
    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M35.5,31.5 A2,2 0 0 1 37.5,29.5 L70.5,29.5 A2,2 0 0 1 72.5,31.5 L72.5,34.5 L35.5,41.5 Z" />

    <!-- The hinge. One bar: at icon size a seam and a bar are the same mark. -->
    <path
        android:fillColor="#FF46536A"
        android:pathData="M45,52.6 L63,52.6 A1.2,1.2 0 0 1 64.2,53.8 L64.2,54.2 A1.2,1.2 0 0 1 63,55.4 L45,55.4 A1.2,1.2 0 0 1 43.8,54.2 L43.8,53.8 A1.2,1.2 0 0 1 45,52.6 Z" />

    <!--
      Bottom screen: narrower than the top one, which is the proportion that
      makes this a particular kind of device rather than two rectangles.
    -->
    <path
        android:pathData="M40,57 L68,57 A2,2 0 0 1 70,59 L70,76.5 A2,2 0 0 1 68,78.5 L40,78.5 A2,2 0 0 1 38,76.5 L38,59 A2,2 0 0 1 40,57 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="57"
                android:endX="70"
                android:endY="78.5"
                android:type="linear">
                <item android:offset="0" android:color="#FF3F82E8" />
                <item android:offset="1" android:color="#FF4048C8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
